# Disable directory browsing
Options -Indexes

# React / Vite Single-Page Application (SPA) routing for Hostinger (Apache / LiteSpeed)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files, directories, and symlinks directly
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^(assets|__l5e|lovable-uploads)/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteCond %{REQUEST_URI} !\.(png|jpe?g|webp|gif|svg|ico|mp4|mp3|woff2?|ttf|css|js|map|json|xml|txt)$ [NC]

  # Route all other paths to index.html so React Router handles them
  RewriteRule . /index.html [L]
</IfModule>

# Enable Gzip / Deflate compression for faster page loads
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser caching for static assets (Vite hashed assets cache long-term, index.html stays fresh)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
